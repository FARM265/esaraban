# สร้างเป็น /etc/nginx/conf.d/default.conf ตอนเริ่ม container (แทนค่า ${SERVER_NAME})

upstream django {
    server web:8000;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    server_tokens off;
    client_max_body_size 60m;   # ไฟล์ละไม่เกิน 20 MB รวมไม่เกิน 50 MB ต่อครั้ง เผื่อข้อมูลฟอร์ม

    # ไฟล์ CSS/JS/ฟอนต์
    location /static/ {
        alias /srv/staticfiles/;
        expires 7d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ไฟล์เอกสารถูกเข้ารหัสบนดิสก์ Django จึงเป็นผู้ถอดรหัสและส่งไฟล์เองหลังตรวจสิทธิ์
    # nginx ไม่เปิดให้เข้าถึงโฟลเดอร์ไฟล์เอกสารโดยตรงไม่ว่าทางใด

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;   # IP จริงของผู้ใช้ ใช้ล็อกบัญชีและ Audit Log
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
