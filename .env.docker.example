# คัดลอกเป็น .env.docker แล้วแก้ทุกค่าที่เขียนว่า CHANGE_ME
# ห้าม commit ไฟล์ .env.docker เข้า Git

# ชื่อเครื่องหรือโดเมนภายในที่ผู้ใช้จะพิมพ์ในเบราว์เซอร์ เช่น esaraban.local
SERVER_NAME=localhost

# สร้างค่าใหม่: docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME

# ต้องมี SERVER_NAME และ 127.0.0.1 (ใช้โดย health check ภายใน)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost

# ฐานข้อมูล (สร้างให้อัตโนมัติตอนเริ่มครั้งแรก) รหัสผ่านใช้ตัวอักษรและตัวเลข
POSTGRES_DB=esaraban
POSTGRES_USER=esaraban_app
POSTGRES_PASSWORD=CHANGE_ME

ORG_CODE=ปช XXXX
PRIVATE_STORAGE_ROOT=private_storage

# ช่วงทดลองใช้ใบรับรอง self-signed ให้ตั้ง HSTS เป็น 0
# เมื่อใช้ใบรับรองจริงของหน่วยงานแล้วจึงเปลี่ยนเป็น 31536000
SECURE_HSTS_SECONDS=0

# ลายมือชื่อดิจิทัลด้วยใบรับรองทดสอบ (ไม่มีผลทางกฎหมาย) ตั้งเป็น False เพื่อให้เลือกได้เฉพาะภาพลายมือชื่อ
# ESARABAN_DIGITAL_SIGNING=True
