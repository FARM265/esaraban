# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของท่าน
# ห้าม commit ไฟล์ .env เข้า Git (มีกำหนดไว้ใน .gitignore แล้ว)

# สร้างค่าใหม่ด้วย: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# รูปแบบ postgres://ผู้ใช้:รหัสผ่าน@host:port/ชื่อฐานข้อมูล
# รหัสผ่านควรเป็นตัวอักษรและตัวเลขเท่านั้น เพื่อไม่ต้อง URL-encode
DATABASE_URL=postgres://esaraban_app:CHANGE_ME@localhost:5432/esaraban

# โฟลเดอร์เก็บไฟล์เอกสาร ต้องอยู่นอกโฟลเดอร์ static และไม่เปิดให้เว็บเข้าถึงตรง
PRIVATE_STORAGE_ROOT=private_storage

# รหัสหน่วยงานสำหรับเลขหนังสือ (ระบบทดลองใช้ค่าสมมติ)
ORG_CODE=ปช XXXX

# ลายมือชื่อดิจิทัลด้วยใบรับรองทดสอบ (ไม่มีผลทางกฎหมาย) ตั้งเป็น False เพื่อให้เลือกได้เฉพาะภาพลายมือชื่อ
# ESARABAN_DIGITAL_SIGNING=True
